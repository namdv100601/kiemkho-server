{
  "name": "nhamay-pmkiemke-server2",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "test": "npm run build && node --test tests/orders.controller.test.js",
    "start": "node dist/main.js",
    "seed": "ts-node -r tsconfig-paths/register src/seed/run-seed.ts",
    "db:migrate:worker-job-title": "ts-node -r tsconfig-paths/register src/migrations/add-worker-job-title.ts",
    "db:migrate:supply-orders": "ts-node -r tsconfig-paths/register src/migrations/add-supply-order-fields.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "templates:prepare-xa": "node scripts/prepare-xa-template.mjs",
    "templates:prepare-stages": "node scripts/prepare-stage-templates.mjs",
    "templates:prepare-kcs": "node scripts/prepare-kcs-template.mjs",
    "templates:prepare-boi": "node scripts/prepare-boi-template.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "docx": "^9.7.1",
    "docxtemplater": "^3.69.3",
    "exceljs": "^4.4.0",
    "js-yaml": "5.2.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "pizzip": "^3.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/passport-jwt": "^4.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "js-yaml": "5.2.3",
    "picomatch": "4.0.5"
  }
}
